# WPGraphQL endpoint for the local WordPress + ACF + Polylang backend that powers
# real (non-mock) vehicle models. Copy this file to `.env.local` and adjust if your
# local WordPress isn't at the default path.
#
# If unset, lib/data/wpgraphql.ts falls back to the confirmed-working local default
# below, so this file is optional for local development.
WPGRAPHQL_ENDPOINT=http://localhost/arcfox/graphql
